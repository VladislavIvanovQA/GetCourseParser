{
  "manifest_version": 3,
  "name": "GetCourse Downloader Bridge",
  "version": "1.5.0",
  "description": "Sends lesson page data to local GetCourse Downloader (portable exe).",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "webRequest",
    "scripting",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["m3u8.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GetCourse Downloader",
    "default_popup": "popup.html"
  }
}
